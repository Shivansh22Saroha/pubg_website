# API (ENVIRONMENT §1). Copy to env/server.env on the VM, chmod 600. Generate secrets with
#   openssl rand -base64 48
NODE_ENV=production
PORT=4000
APP_ORIGIN=https://app.example.com
DATABASE_URL=postgresql://rl:CHANGE_ME_PG@postgres:5432/rotationlab?schema=public
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
JWT_SECRET=CHANGE_ME_48_RANDOM_BYTES
JWT_SECRET_PREVIOUS=
JWT_ISSUER=rotationlab
JWT_AUDIENCE=rotationlab-web
COOKIE_SECURE=true
IP_HASH_SALT=CHANGE_ME_32_RANDOM_BYTES
TRUST_PROXY=true
LOG_LEVEL=info
EMAIL_ENABLED=false
DEMO_BOARD_IDS=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
METRICS_TOKEN=
MAINTENANCE=false
