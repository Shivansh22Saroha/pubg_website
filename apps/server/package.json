{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@rotationlab/shared": "workspace:*",
    "@sentry/node": "11.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.13",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.1.7",
    "prom-client": "15.1.3",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4"
  }
}
