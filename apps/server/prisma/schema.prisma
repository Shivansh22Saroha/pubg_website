// DATABASE_SCHEMA.md. Raw-SQL additions Prisma can't express (citext extension, CHECKs,
// partial indexes) live in the migration files — keep them when regenerating.
// IDs are UUIDv7 generated in app code (src/lib/ids.ts); gen_random_uuid() is only a fallback.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String         @unique @db.Citext
  username         String         @unique @db.Citext
  displayName      String         @map("display_name") @db.VarChar(32)
  ign              String?        @db.VarChar(32)
  avatarColor      String         @default("#38BDF8") @map("avatar_color") @db.Char(7)
  passwordHash     String         @map("password_hash")
  emailVerifiedAt  DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  refreshTokens    RefreshToken[]
  emailTokens      EmailToken[]
  memberships      RoomMember[]
  ownedRooms       Room[]         @relation("RoomOwner")
  createdInvites   RoomInvite[]   @relation("InviteCreator")
  bans             RoomBan[]      @relation("BannedUser")
  bansIssued       RoomBan[]      @relation("BanIssuer")

  @@map("users")
}

model RefreshToken {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the opaque token; the raw token is never stored
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  /// rotation family = session id (`sid` claim); reuse of a rotated token revokes the family
  familyId    String        @map("family_id") @db.Uuid
  replacedBy  String?       @map("replaced_by") @db.Uuid
  userAgent   String?       @map("user_agent") @db.VarChar(256)
  ipHash      String?       @map("ip_hash") @db.Char(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement RefreshToken? @relation("Rotation", fields: [replacedBy], references: [id], onDelete: SetNull)
  replaces    RefreshToken? @relation("Rotation")

  @@unique([replacedBy])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// verification + password reset tokens (P1, behind EMAIL_ENABLED)
model EmailToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String    @db.VarChar(16)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

enum RoomRole {
  OWNER
  EDITOR
  VIEWER
}

enum MapId {
  ERANGEL
  MIRAMAR
  RONDO
}

model Room {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String       @db.VarChar(40)
  description    String?      @db.VarChar(280)
  ownerId        String       @map("owner_id") @db.Uuid
  passwordHash   String?      @map("password_hash")
  defaultRole    RoomRole     @default(EDITOR) @map("default_role")
  isLocked       Boolean      @default(false) @map("is_locked")
  maxMembers     Int          @default(16) @map("max_members") @db.SmallInt
  lastActivityAt DateTime     @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  owner          User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members        RoomMember[]
  invites        RoomInvite[]
  boards         Board[]
  bans           RoomBan[]

  @@index([ownerId])
  @@map("rooms")
}

model RoomMember {
  roomId     String    @map("room_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       RoomRole
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_members")
}

model RoomInvite {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String    @map("room_id") @db.Uuid
  /// 10-char Crockford base32 (~50 bits, CSPRNG)
  code      String    @unique @db.Char(10)
  createdBy String?   @map("created_by") @db.Uuid
  role      RoomRole
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator   User?     @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@map("room_invites")
}

model Board {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  name         String   @db.VarChar(40)
  mapId        MapId    @map("map_id")
  position     Int
  lastSeq      BigInt   @default(0) @map("last_seq")
  elementCount Int      @default(0) @map("element_count")
  thumbnailKey String?  @map("thumbnail_key")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  layers       Layer[]
  elements     Element[]
  ops          BoardOp[]

  @@index([roomId, position])
  @@map("boards")
}

model Layer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String   @db.VarChar(32)
  color     String   @db.Char(7)
  position  Int
  visible   Boolean  @default(true)
  locked    Boolean  @default(false)
  seq       BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  elements  Element[]

  @@index([boardId, position])
  @@map("layers")
}

/// kicked-and-blocked users; invite accept rejects them (Phase 4 follow-up)
model RoomBan {
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bannedBy  String?  @map("banned_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  issuer    User?    @relation("BanIssuer", fields: [bannedBy], references: [id], onDelete: SetNull)

  @@id([roomId, userId])
  @@map("room_bans")
}

enum ElementType {
  STROKE
  LINE
  ARROW
  CIRCLE
  POLYGON
  TEXT
  MARKER
}

model Element {
  id        String      @id @db.Uuid
  boardId   String      @map("board_id") @db.Uuid
  layerId   String      @map("layer_id") @db.Uuid
  type      ElementType
  /// world units (cm); shape per type — DATABASE_SCHEMA §4
  geometry  Json
  style     Json
  props     Json        @default("{}")
  z         Int         @default(0)
  /// board seq of the last write (LWW)
  seq       BigInt
  createdBy String?     @map("created_by") @db.Uuid
  updatedBy String?     @map("updated_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  layer     Layer       @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([layerId])
  @@map("elements")
}

/// short-lived replay log for delta resync (24 h / last 1 000 per board)
model BoardOp {
  boardId   String   @map("board_id") @db.Uuid
  seq       BigInt
  opId      String   @map("op_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  kind      String   @db.VarChar(24)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([boardId, seq])
  @@index([createdAt])
  @@map("board_ops")
}
