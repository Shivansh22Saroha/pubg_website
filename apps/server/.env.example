# Copy to .env — see docs/ENVIRONMENT.md. Generate secrets with: openssl rand -base64 48
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://rl:rl_dev_pw@localhost:5432/rotationlab?schema=public
REDIS_URL=redis://:redis_dev_pw@localhost:6379/0

JWT_SECRET=replace-with-48-random-bytes-base64-xxxxxxxxxxxxxxxx
JWT_SECRET_PREVIOUS=
JWT_ISSUER=rotationlab
JWT_AUDIENCE=rotationlab-web
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_SECURE=false
COOKIE_DOMAIN=
IP_HASH_SALT=replace-with-random-salt-xxxxxxxx

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2

MAX_ROOM_MEMBERS=16
MAX_BOARDS_PER_ROOM=20
MAX_ELEMENTS_PER_BOARD=5000
MAX_OWNED_ROOMS=30

CORS_DEV_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=debug

EMAIL_ENABLED=false
SENTRY_DSN=
METRICS_TOKEN=
