# Copy to .env — see docs/ENVIRONMENT.md. Generate secrets with: openssl rand -base64 48
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
# 127.0.0.1, not localhost: compose binds IPv4 only, and on Windows the Prisma engine tries ::1
# first, so every new pooled connection waits ~2 s for the refusal (P2028 under load)
DATABASE_URL=postgresql://rl:rl_dev_pw@127.0.0.1:5432/rotationlab?schema=public
REDIS_URL=redis://:redis_dev_pw@127.0.0.1:6379/0

JWT_SECRET=replace-with-48-random-bytes-base64-xxxxxxxxxxxxxxxx
JWT_SECRET_PREVIOUS=
JWT_ISSUER=rotationlab
JWT_AUDIENCE=rotationlab-web
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_SECURE=false
COOKIE_DOMAIN=
IP_HASH_SALT=replace-with-random-salt-xxxxxxxx

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2

MAX_ROOM_MEMBERS=16
MAX_BOARDS_PER_ROOM=20
MAX_ELEMENTS_PER_BOARD=5000
MAX_OWNED_ROOMS=30

CORS_DEV_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=debug

EMAIL_ENABLED=false
# with EMAIL_ENABLED=true; dev: `docker compose --profile email up -d mailpit` → UI on :8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RotationLab <no-reply@example.com>
# /explore demo boards (FEATURES F13): `pnpm --filter server seed` prints this line
DEMO_BOARD_IDS=
# dev seed only (alice / bob); seeding dev users refuses to run in production
SEED_DEV_PASSWORD=devpassword123!
SENTRY_DSN=
METRICS_TOKEN=

RATE_LIMITS_ENABLED=true
REFRESH_REUSE_GRACE_SEC=10
# board thumbnails (Phase 11): local disk by default (served at /api/v1/assets/*); set all five
# S3 values + PUBLIC_ASSETS_BASE_URL for Cloudflare R2 / AWS S3 (docs/ENVIRONMENT.md)
ASSETS_DIR=data/assets
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
PUBLIC_ASSETS_BASE_URL=
