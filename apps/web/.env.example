# Copy to .env.local — see docs/ENVIRONMENT.md. Only NEXT_PUBLIC_* reach the browser; no secrets here.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_SOCKET_PATH=/realtime
NEXT_PUBLIC_TILES_BASE_URL=/tiles
# dev: websocket upgrades do not pass through the Next dev rewrite, so the socket goes straight
# to the API (the localhost auth cookie is sent across ports). Leave empty in production.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

INTERNAL_API_URL=http://localhost:4000

# server-only (read per request, never sent to the browser)
# /maps/[mapId] dev viewer: default on in dev, off in production unless "true"
ENABLE_DEV_PAGES=
# /.well-known/security.txt Contact (mailto: or https:); unset → 404
SECURITY_CONTACT=mailto:security@example.com
