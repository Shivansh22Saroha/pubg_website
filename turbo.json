{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", ".env*", "!e2e/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "INTERNAL_API_URL", "API_PROXY_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "REDIS_URL",
    "TEST_DATABASE_URL",
    "TEST_REDIS_URL",
    "APP_ORIGIN",
    "JWT_SECRET",
    "JWT_ISSUER",
    "JWT_AUDIENCE",
    "COOKIE_SECURE",
    "IP_HASH_SALT",
    "TRUST_PROXY",
    "NODE_ENV",
    "PORT",
    "ARGON2_MEMORY_KIB",
    "ARGON2_ITERATIONS",
    "RATE_LIMITS_ENABLED",
    "NEXT_PUBLIC_*",
    "INTERNAL_API_URL",
    "API_PROXY_URL",
    "NEXT_TELEMETRY_DISABLED",
    "REFRESH_REUSE_GRACE_SEC"
  ]
}
